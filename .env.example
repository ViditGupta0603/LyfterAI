# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- required ---
# Comma-separated key pool, at least 2 keys. Ids are key_1, key_2, ... in this order.
# Use keys from two DIFFERENT Google projects (Gemini rate limits are per project).
LLM_API_KEYS=your_first_key_here,your_second_key_here
# Docker: sqlite:////data/app.db   |   running locally without Docker: sqlite:///./data/app.db
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test hook (set true on the deployed backend too)
ENABLE_FAILURE_SIMULATION=true

# --- LLM ---
# Measured 2026-11-21 with BOTH keys: 3.5-flash-lite ~0.66 s on each. 2.5-flash-lite is no longer
# offered to newly created Google projects (404), so it cannot serve a two-project key pool.
LLM_MODEL=gemini/gemini-3.5-flash-lite
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.
MAX_HISTORY_MESSAGES=40
ATTEMPT_TIMEOUT_SECONDS=25
REQUEST_BUDGET_SECONDS=45
# Optional; unset by default because Gemini 3+ deprecates sampling params
# TEMPERATURE=0.7
# Optional: lower Gemini 3.x thinking to cut latency (e.g. minimal / low). Unset = model default.
# REASONING_EFFORT=low

# --- cache ---
CACHE_ENABLED=true
# Docker: /data/llm_cache   |   locally without Docker: ./data/llm_cache
CACHE_DIR=/data/llm_cache
# Optional expiry in seconds (unset = keep until evicted)
# CACHE_TTL_SECONDS=86400

LOG_LEVEL=INFO
